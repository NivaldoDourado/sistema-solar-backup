{
  "query": "\n-- Let's get ALL distinct tags in item_despesa_importado for period 60001\n-- and check which ones DON'T have a direct match with equipamentos.codigoTag\nSELECT DISTINCT i.equipamentoTag, i.equipamentoSistemaId, e.codigoTag as cadastroTag\nFROM item_despesa_importado i\nLEFT JOIN equipamentos e ON e.id = i.equipamentoSistemaId\nWHERE i.periodoCustoId = 60001\nAND i.equipamentoSistemaId IS NULL\nORDER BY i.equipamentoTag\nLIMIT 50;\n",
